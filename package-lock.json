    },
    "packages/editor-core": {
      "name": "@kadmeion/editor-core",
      "version": "0.1.0"
    },
    "node_modules/@kadmeion/storage-adapters": {
      "resolved": "packages/storage-adapters",
      "link": true
    },
    "packages/storage-adapters": {
      "name": "@kadmeion/storage-adapters",
      "version": "0.1.0"
    }

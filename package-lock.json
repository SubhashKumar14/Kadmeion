{
  "name": "kadmeion",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "kadmeion",
      "version": "0.1.0",
      "workspaces": [
        "packages/contracts",
        "packages/editor-core",
        "packages/storage-adapters"
      ],
      "devDependencies": {
        "typescript": "5.8.3"

{
  "name": "kadmeion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "workspaces": [
    "packages/contracts",
    "packages/editor-core",
    "packages/storage-adapters"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/contracts/*.test.ts tests/editor/*.test.ts",
    "check:file-budget": "node scripts/check-file-budget.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}

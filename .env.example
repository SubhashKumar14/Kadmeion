# Public browser-safe values only. Use local Supabase values for development.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Do not add service_role / secret keys to VITE_ variables.

# Supabase Edge Function (server secret configuration, NEVER browser):
# KADMEION_ASSET_ATTESTATION_ENABLED=false
# KADMEION_ALLOWED_ATTEST_ORIGINS=https://your-approved-frontend.example
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY/ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# are supplied by the secure Supabase Edge Function environment.
# The attestation feature remains OFF until hosted Auth/Storage/quotas are proved.

# B4 publication Edge, intentionally disabled until an approved free host is
# verified for canonical route + direct asset revocation and safe quotas.
# These are server-side configuration names; NEVER prefix them with VITE_.
# KADMEION_RELEASE_WORKER_ENABLED=false
# KADMEION_RELEASE_HOST_APPROVED=false
# KADMEION_RELEASE_HOST_REVOCATION_VERIFIED=false
# KADMEION_RELEASE_HOST_ORIGIN=https://approved-free-host.example
# KADMEION_RELEASE_HOSTNAME=approved-free-host.example
# KADMEION_ALLOWED_PUBLISH_ORIGINS=https://approved-frontend.example

# B4 host probe is read-only and opt-in. It checks only explicitly supplied
# URLs, not provider backup retention, historical CDN caches or all assets.
# KADMEION_HOST_REVOCATION_PROBE_ENABLED=false
